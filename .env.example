# Copiá este archivo a .env y completá los valores.

# Postgres. En desarrollo local podés usar `npx prisma dev` o un contenedor propio.
DATABASE_URL="postgresql://usuario:password@localhost:5432/entrada_segura?schema=public"

# Auth.js — cualquier string aleatorio largo sirve. Generalo con: openssl rand -base64 32
# (también se reutiliza para firmar el `state` del flujo OAuth de Mercado Pago).
AUTH_SECRET=""

# Credenciales OAuth de Google (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Mercado Pago (modelo Marketplace) -------------------------------------
# Panel de la app: https://www.mercadopago.com.ar/developers/panel
# Usar credenciales de PRUEBA hasta confirmar el pasaje a producción.

# Credenciales de tu aplicación (no de un vendedor puntual) — se usan para el
# intercambio OAuth (obtener/renovar el access_token de cada vendedor).
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Access token de tu propia cuenta de Mercado Pago (la de la plataforma).
MERCADOPAGO_ACCESS_TOKEN=""

# Public key de TU cuenta (plataforma), expuesta al navegador — se usa para
# tokenizar la tarjeta en el checkout (CardForm). Es información pública,
# por eso lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Secret para validar la firma de los webhooks de Mercado Pago (se configura
# en el panel de la app, sección "Notificaciones" / webhooks).
MERCADOPAGO_WEBHOOK_SECRET=""

# Clave de 32 bytes en base64 para encriptar los access/refresh token de cada
# vendedor conectado antes de guardarlos. Generala con: openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY=""

# URL pública del sitio — se usa para construir el redirect_uri de OAuth y la
# notification_url de los pagos. En producción: https://escrow.ar (o el
# subdominio que corresponda). El redirect_uri completo (NEXT_PUBLIC_APP_URL
# + /api/connected-accounts/oauth/callback) tiene que estar dado de alta en
# el panel de la app de Mercado Pago.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comisión de la plataforma, dividida entre comprador y vendedor (en fracción, no %).
PLATFORM_FEE_BUYER_PCT="0.04"
PLATFORM_FEE_SELLER_PCT="0.04"

# Horas desde la descarga de la entrada hasta que se agenda la captura
# (liberación) automática del pago, si el comprador no abrió una disputa.
RELEASE_TIMEOUT_HOURS="48"

# Secret para autorizar al worker/cron que ejecuta las capturas vencidas
# (header "Authorization: Bearer <este valor>" en /api/cron/capture-orders).
CRON_SECRET=""

# --- Facturación electrónica ARCA (ex-AFIP) de la comisión -----------------
# "true" para activar. Si falta cualquier otro dato de esta sección con
# ARCA_ENABLED=true, la facturación queda desactivada (no rompe el resto).
ARCA_ENABLED="false"
# Si es "false", la factura NO se emite sola al liberar el pago — solo
# queda disponible el botón de emisión manual para un admin.
ARCA_AUTO_INVOICE_ON_RELEASE="true"

ARCA_CUIT=""
# Certificado y clave privada (.crt/.key) de la facturación electrónica,
# codificados en base64 completo (ej. `base64 -w0 cert.crt`). Se guardan así
# — y no como ruta de archivo — para que funcione igual en cualquier
# plataforma de deploy.
ARCA_CERT_BASE64=""
ARCA_KEY_BASE64=""

# "testing" (homologación) o "production". Usar "testing" hasta certificar
# el pasaje a producción con ARCA.
ARCA_ENVIRONMENT="testing"

ARCA_PUNTO_VENTA="1"
# 11 = Factura C (Monotributo, sin discriminar IVA). Cambiar si en algún
# momento se pasa a Responsable Inscripto (1 = Factura A, 6 = Factura B).
ARCA_TIPO_COMPROBANTE="11"

# Condición de IVA del receptor cuando tiene CUIT cargado (no se consulta el
# padrón de ARCA para saber la real). 6 = Responsable Monotributo.
ARCA_DEFAULT_CONDICION_IVA_RECEPTOR_CUIT="6"

# Opcional — solo si ARCA migra los dominios de los webservices.
ARCA_WSAA_URL=""
ARCA_WSFE_URL=""
