# Copiá este archivo a ".env" y completá tus valores.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# API key de OpenAI (la misma cuenta de "ChatGPT"). Se usa para:
#  - transcribir lo que dice el nene/nena (Whisper)
#  - generar el dibujo para colorear (gpt-image-1)
OPENAI_API_KEY=sk-...

# Nombre de la cola de impresión en CUPS (ver README, sección Impresora).
# Se obtiene con: lpstat -p -d
PRINTER_NAME=HP_LaserJet

# Pines GPIO (numeración BCM) donde están conectados los botones físicos.
# Botón 1: mantener apretado para grabar lo que dice, soltar para generar el dibujo.
# Botón 2: apretar para imprimir el último dibujo generado.
BUTTON_RECORD_PIN=17
BUTTON_PRINT_PIN=27

# Duración mínima y máxima de grabación (segundos) mientras se mantiene apretado el botón 1.
RECORD_MIN_SECONDS=0.3
RECORD_MAX_SECONDS=8

# Dispositivo de audio de entrada (micrófono). Dejalo vacío para usar el default del sistema.
# Para listar dispositivos: python -m sounddevice
AUDIO_INPUT_DEVICE=

# Tamaño de la imagen generada. 1024x1536 (vertical) se parece a la
# proporción de una hoja A4, así que aprovecha más la hoja al imprimir.
# Opciones válidas de gpt-image-1: 1024x1024, 1024x1536, 1536x1024, auto
IMAGE_SIZE=1024x1536

# Puerto donde corre la interfaz web local que se muestra en la pantalla
WEB_PORT=5000

# Segundos de "cooldown" tras imprimir, para evitar dobles impresiones por apretar de más
PRINT_COOLDOWN_SECONDS=5

# Segundos que se espera a que la impresora confirme un trabajo antes de
# darlo por colgado, cancelarlo, y avisar el error en pantalla.
PRINT_TIMEOUT_SECONDS=25
