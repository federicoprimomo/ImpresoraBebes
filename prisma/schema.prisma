// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — required shape for the Prisma adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  // Identificación fiscal (CUIT/DNI), opcional — se usa como receptor de la
  // factura de comisión (ver Invoice). Sin esto, se factura a "Consumidor
  // Final", válido para Factura C por debajo de cierto monto.
  taxIdType   String? // "CUIT" | "DNI"
  taxIdNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // Cuenta de Mercado Pago del vendedor, conectada vía OAuth (modelo
  // Marketplace). Sin esto no se le puede pagar por split.
  connectedAccount ConnectedAccount?

  listings         Listing[] @relation("SellerListings")
  ordersAsBuyer    Order[]   @relation("BuyerOrders")
  ordersAsSeller   Order[]   @relation("SellerOrders")
  resolvedDisputes Dispute[] @relation("ResolvedByAdmin")
}

enum ConnectedAccountStatus {
  CONNECTED
  DISCONNECTED // el usuario revocó el acceso o lo desconectamos nosotros
  ERROR // el refresh del token falló y hace falta reconectar
}

// Vínculo OAuth con la cuenta de Mercado Pago de un vendedor ("tercero" en
// el modelo Marketplace). Se crea/actualiza en el callback de OAuth.
model ConnectedAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  mpUserId Int? // user_id de Mercado Pago del vendedor, para logs/soporte

  // Tokens encriptados (ver src/lib/mp-crypto.ts) — nunca se guardan en claro.
  accessTokenEnc       String    @db.Text
  refreshTokenEnc      String    @db.Text
  accessTokenExpiresAt DateTime? // para saber cuándo conviene renovar antes de usarlo

  publicKey String?
  scope     String?
  liveMode  Boolean @default(false)

  status ConnectedAccountStatus @default(CONNECTED)

  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  disconnectedAt DateTime?
}

enum ListingStatus {
  ACTIVE // publicada, disponible para compra
  RESERVED // hay una orden en curso sobre ella
  SOLD // vendida y liberada
  CANCELLED // el vendedor la dio de baja
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime?
  priceArs    Int // precio base en ARS, en centavos para evitar floats
  quantity    Int           @default(1)
  status      ListingStatus @default(ACTIVE)

  sellerId String
  seller   User   @relation("SellerListings", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// Ciclo de vida completo de una compra con retención de pago (escrow),
// implementado como autorización de tarjeta (capture=false) + captura
// posterior vía Mercado Pago (modelo Marketplace, split con application_fee).
enum OrderStatus {
  PENDING_PAYMENT // orden creada, autorización en curso contra Mercado Pago
  PAYMENT_FAILED // la autorización fue rechazada (tarjeta declinada, etc.)
  PAYMENT_HELD // pago autorizado y retenido ("reservado"), esperando entrega
  DELIVERED // el vendedor subió el archivo de la entrada
  RELEASED // pago capturado: se liberó al vendedor (menos comisión)
  DISPUTED // el comprador abrió una disputa antes del timeout
  REFUNDED // se anuló/reembolsó el pago (disputa resuelta a favor del comprador)
  EXPIRED // pasaron los 7 días de autorización de MP sin capturarse
  CANCELLED // la orden se canceló antes de llegar a PAYMENT_HELD
}

model Order {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  status OrderStatus @default(PENDING_PAYMENT)

  // Montos en centavos de ARS.
  amountArs       Int // total cobrado al comprador (precio + comisión del comprador)
  buyerFeeArs     Int  @default(0) // comisión que paga el comprador (sumada al precio)
  sellerFeeArs    Int  @default(0) // comisión que se descuenta al vendedor al liberar
  sellerPayoutArs Int? // monto final liquidado al vendedor (amount - buyerFee - sellerFee)

  // Datos del comprador enviados a Mercado Pago (snapshot al momento de pagar).
  payerEmail     String
  payerDocType   String? // ej. "DNI"
  payerDocNumber String?

  // Integración con Mercado Pago (Checkout API, modelo Marketplace).
  mpPaymentId String? // id del pago creado con capture=false

  // Claves de idempotencia — se generan una vez y se reutilizan en reintentos
  // de la misma operación para no duplicar cobros/capturas ante fallas de red.
  idempotencyKeyCreate  String  @unique
  idempotencyKeyCapture String? @unique

  captureAttempts  Int     @default(0)
  lastPaymentError String? @db.Text // motivo del último rechazo/fallo (autorización o captura)

  authorizedAt      DateTime? // cuándo Mercado Pago autorizó y retuvo el pago
  captureDeadlineAt DateTime? // authorizedAt + 7 días — límite duro de MP para capturar
  deliveredAt       DateTime? // cuándo el vendedor subió el archivo
  downloadedAt      DateTime? // cuándo el comprador descargó el archivo (dispara el timeout)
  releaseDueAt      DateTime? // downloadedAt + ventana de disputa; el worker captura pasado este momento
  releasedAt        DateTime? // cuándo se confirmó la captura (fondos ya liberados al vendedor)
  cancelledAt       DateTime? // cuándo pasó a CANCELLED o REFUNDED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery        DeliveryFile?
  dispute         Dispute?
  commissionEntry CommissionLedgerEntry?
  invoice         Invoice?

  @@index([status, releaseDueAt])
  @@index([status, captureDeadlineAt])
  @@index([mpPaymentId])
}

model DeliveryFile {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // storageKey es una clave opaca hacia el backend de storage (ver
  // src/lib/storage.ts) — hoy apunta a FileBlob, pero el resto del código
  // no sabe ni le importa dónde vive realmente el archivo.
  storageKey  String
  fileName    String
  contentType String
  sizeBytes   Int
  fileHash    String // sha256 del contenido, para detectar reventa duplicada de la misma entrada

  uploadedAt DateTime @default(now())

  @@index([fileHash])
}

// Backend de storage por default: el archivo vive en la base. Suficiente
// para el tamaño de un PDF/QR de entrada; si hiciera falta más volumen,
// esto se reemplaza por un backend de storage de objetos sin tocar
// DeliveryFile (storageKey queda siendo un id opaco).
model FileBlob {
  key         String   @id
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASE // el admin decidió liberar el pago al vendedor
  RESOLVED_REFUND // el admin decidió reembolsar al comprador
}

model Dispute {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  reason   String
  evidence String? @db.Text

  status DisputeStatus @default(OPEN)

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedByAdmin", fields: [resolvedById], references: [id])
  resolution   String? @db.Text

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// Registro de comisiones cobradas, para el panel de admin.
model CommissionLedgerEntry {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  buyerFeeArs  Int
  sellerFeeArs Int
  totalFeeArs  Int

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Facturación electrónica (ARCA / ex-AFIP) de la comisión de la plataforma.
// ---------------------------------------------------------------------------

// Token de acceso a los webservices de ARCA (WSAA), cacheado porque tiene
// vigencia de ~12hs y no conviene pedir uno nuevo en cada factura.
model ArcaAuthTicket {
  id      String @id @default(cuid())
  service String @unique // ej. "wsfe"

  token String @db.Text
  sign  String @db.Text

  expirationTime DateTime
  createdAt      DateTime @default(now())
}

enum InvoiceStatus {
  PENDING // se está por emitir (o falló y está pendiente de reintento)
  ISSUED // ARCA aprobó y devolvió CAE
  FAILED // ARCA rechazó, o falló la comunicación
}

// Factura C (por ahora) que la plataforma emite sobre la comisión cobrada
// en una orden. El receptor es el vendedor (a quien se le cobra la
// comisión), salvo que no tenga CUIT/DNI cargado, en cuyo caso se emite a
// "Consumidor Final".
model Invoice {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  status InvoiceStatus @default(PENDING)

  tipoComprobante Int // 11 = Factura C
  puntoVenta      Int
  numero          Int? // asignado por ARCA al emitirse

  receptorDocTipo Int // 80 = CUIT, 96 = DNI, 99 = Consumidor Final
  receptorDocNro  String

  importeTotalArs Int // en centavos — importe de la comisión facturada

  cae            String?
  caeVencimiento DateTime?

  errorMessage String? @db.Text
  rawResponse  String? @db.Text // último response de ARCA, para debug/auditoría

  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Contenido editable desde /admin — textos de la landing, legal, y FAQ. Si
// una key no tiene fila acá, el código usa un default hardcodeado (ver
// src/lib/site-content.ts) — así el sitio nunca queda en blanco si todavía
// no se editó nada.
// ---------------------------------------------------------------------------

model SiteContent {
  key       String   @id // ej. "hero.title", "legal.terminos.body"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Notificaciones por mail — el contenido de cada tipo de mail es editable
// desde /admin/emails, no está hardcodeado en el código. `key` identifica
// el evento (ver src/lib/notifications/catalog.ts para la lista completa
// y qué variables `{{...}}` acepta cada uno).
// ---------------------------------------------------------------------------

model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
