[Unit]
Description=Impresora de dibujos magicos - backend (botones + servidor web)
After=network-online.target cups.service sound.target
Wants=network-online.target

[Service]
Type=simple
# Ajustá User y WorkingDirectory si tu usuario o la ruta del proyecto son distintos
User=pi
WorkingDirectory=/home/pi/ImpresoraBebes
EnvironmentFile=/home/pi/ImpresoraBebes/.env
ExecStart=/home/pi/ImpresoraBebes/venv/bin/python -m app.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
